{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "mock": "node mock/server.ts",
    "demo": "node mock/demo.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "qa": "cucumber-js --config qa/cucumber.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/pngjs": "^6.0.5",
    "jsdom": "^31.0.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
